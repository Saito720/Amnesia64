<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)HPL2LlamaSettings.props" />
  <ItemDefinitionGroup Condition="'$(HPL2WithLlama)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(HPL2LlamaSourceDir)include;$(HPL2LlamaSourceDir)ggml\include;$(HPL2LlamaSourceDir)tools\mtmd;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>HPL2_WITH_LLAMA=1;HPL2_LLAMA_CUDA=$(HPL2LlamaCudaDefine);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Lib>
      <AdditionalDependencies>$(HPL2LlamaBuildDir)\lib\$(Configuration)\HPL2Llama.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>
  <Target Name="CopyHPL2LlamaCudaRuntime" AfterTargets="Build" Condition="'$(HPL2WithLlama)'=='true' and '$(HPL2LlamaBackend)'=='CUDA'">
    <ItemGroup>
      <HPL2LlamaRuntime Include="$(HPL2LlamaBuildDir)\lib\$(Configuration)\*.dll" />
    </ItemGroup>
    <Error Condition="'@(HPL2LlamaRuntime)'==''" Text="The CUDA backend runtime DLLs have not been built." />
    <Copy SourceFiles="@(HPL2LlamaRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
