<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <Keyword>MakeFileProj</Keyword>
    <ProjectGuid>{7d61e937-ad4a-49b2-86c8-8ae3bc9777eb}</ProjectGuid>
    <RootNamespace>LlamaCpp</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="HPL2LlamaSettings.props" />
  <PropertyGroup>
    <CMakeExecutable Condition="'$(CMakeExecutable)'=='' and Exists('$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExecutable>
    <CMakeExecutable Condition="'$(CMakeExecutable)'==''">cmake.exe</CMakeExecutable>
    <HPL2LlamaBuildJobs Condition="'$(HPL2LlamaBuildJobs)'==''">4</HPL2LlamaBuildJobs>
    <RepositoryRoot>$(ProjectDir)..\..\..\</RepositoryRoot>
    <LlamaBuildDir>$(HPL2LlamaBuildDir)</LlamaBuildDir>
    <LlamaVisualStudioInstance>$([System.IO.Path]::GetFullPath('$(VSInstallDir).'))</LlamaVisualStudioInstance>
    <LlamaToolset>$(PlatformToolset)</LlamaToolset>
    <LlamaToolset Condition="'$(HPL2LlamaBackend)'=='CUDA' and '$(HPL2CudaToolkitDirectory)'!=''">$(PlatformToolset),cuda=$(HPL2CudaToolkitDirectory)</LlamaToolset>
    <LlamaCudaOptions>-DHPL2_LLAMA_CUDA=$(HPL2LlamaCudaEnabled)</LlamaCudaOptions>
    <LlamaCudaOptions Condition="'$(HPL2LlamaBackend)'=='CUDA' and '$(HPL2CudaToolkitDirectory)'!=''">$(LlamaCudaOptions) &quot;-DCUDAToolkit_ROOT=$(HPL2CudaToolkitDirectory)&quot;</LlamaCudaOptions>
    <LlamaCudaOptions Condition="'$(HPL2LlamaBackend)'=='CUDA' and '$(HPL2CudaArchitectures)'!=''">$(LlamaCudaOptions) &quot;-DCMAKE_CUDA_ARCHITECTURES=$(HPL2CudaArchitectures)&quot;</LlamaCudaOptions>
    <LlamaConfigureCommand>&quot;$(CMakeExecutable)&quot; -S &quot;$(ProjectDir).&quot; -B &quot;$(LlamaBuildDir)&quot; -G &quot;Visual Studio 18 2026&quot; -A &quot;$(Platform)&quot; -T &quot;$(LlamaToolset)&quot; &quot;-DCMAKE_GENERATOR_INSTANCE=$(LlamaVisualStudioInstance)&quot; $(LlamaCudaOptions)</LlamaConfigureCommand>
    <IntDir>$(RepositoryRoot)bld\llama.cpp-vs\$(Platform)\$(HPL2LlamaBackend)\$(Configuration)\</IntDir>
    <OutDir>$(LlamaBuildDir)\lib\$(Configuration)\</OutDir>
    <NMakeOutput>$(OutDir)HPL2Llama.lib</NMakeOutput>
    <NMakeBuildCommandLine>echo Embedded llama.cpp is disabled. Enable with /p:HPL2WithLlama=true /p:Platform=x64.</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>$(NMakeBuildCommandLine)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>echo Embedded llama.cpp is disabled.</NMakeCleanCommandLine>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HPL2WithLlama)'=='true'">
    <NMakeBuildCommandLine>$(LlamaConfigureCommand) &amp;&amp; &quot;$(CMakeExecutable)&quot; --build &quot;$(LlamaBuildDir)&quot; --config $(Configuration) --target HPL2LlamaArchive --parallel $(HPL2LlamaBuildJobs)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>$(LlamaConfigureCommand) &amp;&amp; &quot;$(CMakeExecutable)&quot; --build &quot;$(LlamaBuildDir)&quot; --config $(Configuration) --target HPL2LlamaArchive --clean-first --parallel $(HPL2LlamaBuildJobs)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>if exist &quot;$(LlamaBuildDir)\CMakeCache.txt&quot; &quot;$(CMakeExecutable)&quot; --build &quot;$(LlamaBuildDir)&quot; --config $(Configuration) --target clean</NMakeCleanCommandLine>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CMakeLists.txt" />
    <None Include="HPL2Llama.props" />
    <None Include="HPL2LlamaSettings.props" />
    <None Include="README.md" />
    <None Include="UPSTREAM.json" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
